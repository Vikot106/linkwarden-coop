# Copied to .env.development.local on first start. Existing .env files are not loaded.
DEV_WEB_PORT=3300
DEV_DB_PORT=55433
DEV_POSTGRES_IMAGE=postgres:18.4-alpine
# These two secrets are generated automatically when the configuration is created.
DEV_POSTGRES_PASSWORD=
NEXTAUTH_SECRET=

SITE_TITLE=Linkwarden 开发环境
INSTANCE_VERSION=v2.16.3-enterprise.dev
NEXT_PUBLIC_ADMIN=1

DEFAULT_LANGUAGE=zh
NEW_USER_DEFAULT_LANGUAGE=zh
ANNOUNCEMENT_ENABLED=true
ANNOUNCEMENT_ID=2.16
ANNOUNCEMENT_MESSAGE="查看 {link} 了解新功能。"
ANNOUNCEMENT_LINK_TEXT="Linkwarden 2.16"
ANNOUNCEMENT_LINK_URL=https://linkwarden.app/blog/releases/2.16

# Enable after running: dev.cmd browser
# Complete single-file HTML preservation also needs the monolith executable on PATH.
DEV_ENABLE_BROWSER=false
